# Version control
.git
.github
.gitignore
.gitattributes

# Dependencies & build artifacts (rebuilt inside the image)
node_modules
build
dist
coverage
.pnp
.pnp.js

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Local / dev env files (use build args or compose env for runtime values)
.env.local
.env.*.local
.env.test
.env.test.local

# Editors & IDEs
.vscode
.idea
*.swp
*.swo

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Docker meta (avoid recursive copy of compose / docker files into the image)
Dockerfile*
docker-compose*.yml
.dockerignore

# Project docs / misc that aren't needed at runtime
README.md
*.md
deploy.sh
testing
src/Pages/sampleDataToSave.json
