# ---------- Runtime ----------
PORT=3000

# ---------- API Configuration ----------
# Base API URL
REACT_APP_BASE_URL=https://panelapi.example.com

# Socket server URL
REACT_APP_SOCKET_URL=https://panelapi.example.com

# ---------- App Configuration ----------
# Encryption secret used in frontend utilities
REACT_APP_ENCRYPTION_SECRET=your-encryption-secret

# API polling interval (ms)
REACT_APP_API_INTERVAL=5000

# Enable/disable socket connection
REACT_APP_IS_SOCKET=true

# Default auth provider
REACT_APP_DEFAULTAUTH=fake
